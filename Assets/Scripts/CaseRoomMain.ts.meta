    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject crimeScene {"hint":"Root of the crime scene (stand-ins + clues); moved under the player at Start"}'
    - '// @input SceneObject suspectLineup {"hint":"Root of the suspect line-up; placed straight ahead when the suspects appear"}'
    - '// @input AssignableType_1 clueMemo {"hint":"Clue 1: memo on the desk"}'
    - '// @input AssignableType_2 clueFootprints {"hint":"Clue 2: footprints on the floor"}'
    - '// @input AssignableType_3 clueClock {"hint":"Clue 3: stopped clock on the wall"}'
    - '// @input AssignableType_4 clueGlass {"hint":"Clue 4: broken glass on the chair"}'
    - '// @input AssignableType_5 cluePhoto {"hint":"Clue 5: torn photo above head height"}'
    - '// @input AssignableType_6 standInDesk {"hint":"Stand-in desk (top at 75 cm)"}'
    - '// @input AssignableType_7 standInChair {"hint":"Stand-in chair (seat at 45 cm)"}'
    - '// @input AssignableType_8 standInWall {"hint":"Stand-in wall section for the clock"}'
    - '// @input AssignableType_9 suspectEdgar {"hint":"Suspect figure: Edgar Hale"}'
    - '// @input AssignableType_10 suspectNora {"hint":"Suspect figure: Nora Vale"}'
    - '// @input AssignableType_11 suspectIris {"hint":"Suspect figure: Iris Bell"}'
    - '// @input AssignableType_12 openingBoard {"hint":"Opening board UI"}'
    - '// @input AssignableType_13 hud {"hint":"Counter + arrow HUD UI"}'
    - '// @input AssignableType_14 caption {"hint":"Caption UI"}'
    - '// @input AssignableType_15 inspectPanel {"hint":"Inspect panel UI (description + Flip / Close, shown just above the clue)"}'
    - '// @input AssignableType_16 clueTag {"hint":"Clue name tag UI"}'
    - '// @input AssignableType_17 suspectsUI {"hint":"Suspect names / alibi / Accuse UI"}'
    - '// @input AssignableType_18 truthPanel {"hint":"Truth panel UI"}'
    - '// @input AssignableType_19 replay {"hint":"Replay controller (gather, threads, culprit walk)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
