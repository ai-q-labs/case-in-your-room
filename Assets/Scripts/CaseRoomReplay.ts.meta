  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CaseRoomReplay – gather, threads and the culprit walk</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec3 threadColor = "{0.72,0.9,1.0}" {"hint":"Color of the glowing threads", "widget":"color"}'
    - '// @input vec3 figureColor = "{1.0,0.74,0.88}" {"hint":"Color of the walking translucent figure", "widget":"color"}'
    - '// @input vec3 footprintColor = "{0.62,0.96,1.0}" {"hint":"Color of the glowing footprints left on the floor", "widget":"color"}'
    - '// @input float walkSpeedCm = 95 {"hint":"Walking speed of the figure in cm per second", "widget":"slider", "min":30, "max":250, "step":5}'
    - '// @input float dwellSec = 3.4 {"hint":"Seconds the figure pauses at each clue (caption time)", "widget":"slider", "min":0.5, "max":8, "step":0.1}'
    - '// @input float gatherDistanceCm = 120 {"hint":"Distance in front of the player where the clues gather, in cm", "widget":"slider", "min":60, "max":200, "step":1}'
    - '// @input float gatherSizeCm = 11 {"hint":"Size of each gathered clue in cm (keep the row of 5 inside the view)", "widget":"slider", "min":5, "max":25, "step":0.5}'
    - '// @input float gatherHeightCm = 14 {"hint":"How far above eye level the clues float when they gather, in cm", "widget":"slider", "min":-30, "max":40, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Strip straight ahead during the walk"}'
    - '// @input float stripDistanceCm = 120 {"hint":"Distance in front of the player of the row of small copies, in cm", "widget":"slider", "min":60, "max":200, "step":1}'
    - '// @input float stripLineHeightCm = -4 {"hint":"Height of the line the small figure walks on, relative to eye level, in cm (the captions sit below it)", "widget":"slider", "min":-30, "max":30, "step":0.5}'
    - '// @input float stripCopySizeCm = 7.5 {"hint":"Largest side of each small copy of a clue, in cm", "widget":"slider", "min":3, "max":15, "step":0.5}'
    - '// @input float stripSpacingCm = 10 {"hint":"Centre-to-centre spacing of the small copies, in cm (keep the row inside the view)", "widget":"slider", "min":5, "max":20, "step":0.5}'
    - '// @input float stripFigureHeightCm = 9 {"hint":"Height of the small walking figure, in cm", "widget":"slider", "min":4, "max":20, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
